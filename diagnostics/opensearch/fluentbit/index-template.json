// Reference index template for filebeat-fluentbit-* -- for testing.
// Apply with: PUT _index_template/filebeat-fluentbit  (body = this file, minus comments)
//
// Why this is NOT a copy of the filebeat-7.12.1 template:
//   - That template is Filebeat's full ECS schema: ~500 fields covering
//     network, process, DNS, threat intel, x509, etc. Fluent Bit's pipeline
//     (tenant_extract.lua + conf.d/scripts.d) never emits any of those --
//     copying it would define hundreds of fields nothing ever writes to.
//   - This template defines only what the pipeline actually produces:
//     tenant_extract.lua's static fields, plus what conf.d/scripts.d add
//     when a service is annotated.
//
// Shards/replicas below are filled in from Day 0 discovery on this cluster:
//   filebeat-7.11.1-2026.07.20 -> number_of_shards=1, number_of_replicas=1
//
// NOT required for Fluent Bit to function -- OpenSearch auto-creates the
// index with dynamic mapping if this is never applied. Apply it for two
// reasons only: (1) shard/replica parity with existing filebeat-* indices,
// and (2) the dynamic_templates block below, which prevents a real risk --
// see "Why dynamic_templates matters" at the bottom of this file.
{
  "index_patterns": ["filebeat-fluentbit-*"],
  "priority": 200,
  "template": {
    "settings": {
      "index": {
        "number_of_shards":   "1",
        "number_of_replicas": "1"
      }
    },
    "mappings": {
      "date_detection": false,
      "dynamic_templates": [
        {
          "decoded_json_strings": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },

        "message":       { "type": "text" },
        "_message":      { "type": "text" },
        "stream":        { "type": "keyword" },
        "index_prefix":  { "type": "keyword" },

        "log": {
          "properties": {
            "file": {
              "properties": {
                "path": { "type": "keyword" }
              }
            }
          }
        },

        "agent": {
          "properties": {
            "name":     { "type": "keyword" },
            "type":     { "type": "keyword" },
            "version":  { "type": "keyword" },
            "hostname": { "type": "keyword" }
          }
        },
        "host": {
          "properties": {
            "name": { "type": "keyword" }
          }
        },
        "input": {
          "properties": {
            "type": { "type": "keyword" }
          }
        },

        "tenant": {
          "properties": {
            "name": { "type": "keyword" },
            "id":   { "type": "keyword" }
          }
        },

        "container": {
          "properties": {
            "id":      { "type": "keyword" },
            "runtime": { "type": "keyword" },
            "image": {
              "properties": {
                "name": { "type": "keyword" }
              }
            }
          }
        },

        "kubernetes": {
          "properties": {
            "namespace": { "type": "keyword" },
            "labels":    { "type": "object" },
            "container": {
              "properties": {
                "name":  { "type": "keyword" },
                "image": { "type": "keyword" }
              }
            },
            "node": {
              "properties": {
                "hostname": { "type": "keyword" },
                "name":     { "type": "keyword" }
              }
            },
            "pod": {
              "properties": {
                "uid":  { "type": "keyword" },
                "name": { "type": "keyword" }
              }
            }
          }
        },

        "_annotation_unsupported":     { "type": "keyword" },
        "_annotation_processor_error": { "type": "keyword" }
      }
    }
  }
}

// -----------------------------------------------------------------------
// Why dynamic_templates matters here specifically
//
// Both conf.d and scripts.d decode a service's JSON log line and merge its
// fields at the record root (decode_json_fields, target=""). Each
// annotated service can have a DIFFERENT JSON shape -- service A might emit
// "timestamp":"2026-01-01T00:00:00Z" (a date-looking string), service B
// might emit "timestamp":"some-trace-id" (not date-like at all). If both
// land in the same index, OpenSearch infers the type from whichever
// document arrives first, and the second service's writes fail with a
// mapping conflict.
//
// This is exactly the risk ARCHITECTURE.md already documents for
// log_processed (which is why that field is discarded, not indexed). The
// decoded fields from conf.d/scripts.d carry the identical risk, because
// they are the same kind of data -- just merged at root instead of nested.
//
// decoded_json_strings forces every such string field to keyword
// unconditionally, so two services' colliding field names can never
// produce a type conflict. Cost: no full-text search on decoded fields.
// If that is required for a specific field, add an explicit mapping for
// it above the dynamic_templates block (explicit mappings always win).
// -----------------------------------------------------------------------
